<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.cisco.defenseclaw.apply</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/cisco/defenseclaw/bin/defenseclaw-gateway</string>
		<string>enterprise</string>
		<string>macos</string>
		<string>ensure</string>
		<string>--reason</string>
		<string>path</string>
		<string>--json</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/Cisco/DefenseClaw/lifecycle.log</string>
	<key>StandardOutPath</key>
	<string>/Library/Logs/Cisco/DefenseClaw/lifecycle.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>Umask</key>
	<integer>63</integer>
	<key>WatchPaths</key>
	<array>
		<string>/opt/cisco/defenseclaw/etc/config.yaml</string>
		<string>/opt/cisco/defenseclaw/etc/secrets</string>
		<string>/opt/cisco/defenseclaw/etc/policies</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/</string>
</dict>
</plist>
